\
_null_clean() {\
    local env="$1"\
    [ -x "$env/bin/python" ] || return 0\
\
    "$env/bin/python" -m pip list --format=freeze 2>/dev/null |\
    while IFS= read -r package; do\
        case "${package%%=*}" in\
            pip|setuptools|wheel) continue ;;\
        esac\
        "$env/bin/python" -m pip uninstall -y "${package%%=*}" >/dev/null 2>&1\
    done\
}\
\
null-activate() {\
    local env="$PWD/.null-venv"\
    [ -d "$env" ] || python3 -m venv "$env"\
\
    _null_clean "$env"\
    source "$env/bin/activate"\
\
    __null_env="$env"\
\
    # Preserve this venv's original deactivate function.\
    eval "$(declare -f deactivate | sed '1s/deactivate/__null_real_deactivate/')"\
\
    deactivate() {\
        __null_real_deactivate "$@"\
        _null_clean "$__null_env"\
        unset __null_env\
    }\
}
